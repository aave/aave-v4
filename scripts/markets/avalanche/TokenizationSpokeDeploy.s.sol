contract Factory {
  function create(
    address hub,
    address token,
    string memory name,
    string memory symbol,
    address proxyAdminOwner
  ) external returns (address) {
    address impl = address(new TokenizationSpokeInstance(hub, token));
    return
      address(
        new TransparentUpgradeableProxy(
          impl,
          proxyAdminOwner,
          abi.encodeCall(TokenizationSpokeInstance.initialize, (name, symbol))
        )
      );
  }
}

